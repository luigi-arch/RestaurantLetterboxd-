# Public Supabase configuration, committed on purpose.
#
# Both values below are designed to be public: they are inlined into the browser
# bundle by Next.js on every build, so treating them as secrets would be
# theatre. What actually protects the data is row-level security, which is
# enabled on every rl_* table and tested in supabase/tests/.
#
# Vercel (or any platform) environment variables take precedence over this file,
# so setting them in the dashboard later overrides these without a code change.
#
# The SERVICE ROLE key must NEVER appear here. It bypasses RLS entirely and
# belongs only in a platform environment variable, used by scripts/.
NEXT_PUBLIC_SUPABASE_URL=https://otucjmkjmsbojghkgnxm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gGmrajsiBz_jR-FBwMLCCw_u_5gAW2k
